# Environment variables for the modernized Next.js site
# Required for Drupal CMS integration

# Drupal backend URL - REQUIRED
# Replace with your actual Drupal URL for production builds
NEXT_PUBLIC_DRUPAL_BASE_URL=https://your-drupal-site.com

# Image domain for Next.js Image optimization
# Should match your Drupal domain
NEXT_IMAGE_DOMAIN=your-drupal-site.com

# OAuth credentials for Drupal (if using Simple OAuth)
# These can be obtained from your Drupal admin
DRUPAL_CLIENT_ID=your-client-id
DRUPAL_CLIENT_SECRET=your-client-secret

# Site identifier (for Drupal multisite)
DRUPAL_SITE_ID=example_marketing

# Front page path
DRUPAL_FRONT_PAGE=/home

# For development, you can use:
# NEXT_PUBLIC_DRUPAL_BASE_URL=http://localhost:8080
# NEXT_IMAGE_DOMAIN=localhost

# Note: For deployment to Vercel/Netlify, set these in your deployment platform's
# environment variables dashboard rather than in .env.local